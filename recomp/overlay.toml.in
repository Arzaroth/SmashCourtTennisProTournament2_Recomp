# ps2_recomp config for one code overlay of .staytrash, filled in by scripts/recomp_overlays.sh.

[general]
input = "@INPUT@"
ghidra_output = "@MAP@"
output = "@OUTPUT@"
single_file_output = false
patch_syscalls = false
patch_cop0 = true
patch_cache = true
module_name = "@NAME@"
module_load = "0x46EA80"
module_guard_size = 64
stubs = []
skip = []
entry_points = [@ENTRIES@]
